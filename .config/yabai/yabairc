yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config layout bsp

yabai -m config top_padding    4
yabai -m config bottom_padding 4
yabai -m config left_padding   4
yabai -m config right_padding  4
yabai -m config window_gap     4

# Keep spaces s1..s10 pinned to displays across monitor (un)plugging.
yabai -m signal --add label=arrange_on_display_added \
  event=display_added action="$HOME/.config/yabai/arrange-spaces.sh"
yabai -m signal --add label=arrange_on_display_removed \
  event=display_removed action="$HOME/.config/yabai/arrange-spaces.sh"

# Make sure a window is focused after switching space / display, so that
# directional focus (yabai -m window --focus west/...) always has a reference.
yabai -m signal --add label=focus_recover_on_space_changed \
  event=space_changed action="$HOME/.config/yabai/focus.sh"
yabai -m signal --add label=focus_recover_on_display_changed \
  event=display_changed action="$HOME/.config/yabai/focus.sh"

"$HOME/.config/yabai/arrange-spaces.sh" &
